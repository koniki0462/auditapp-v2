# Non-secret defaults for production (npm run build / start).
# Replace the placeholder URLs with your production hosts.
# Secrets go in .env.production.local or the hosting provider's settings.
NEXT_PUBLIC_APP_ENV=production
NEXT_PUBLIC_APP_NAME=AuditApp
NEXT_PUBLIC_SITE_URL=https://auditapp.example.com
NEXT_PUBLIC_API_BASE_URL=https://api.auditapp.example.com/api
