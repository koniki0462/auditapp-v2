# Template listing every environment variable the app reads.
#
# Committed, non-secret defaults per environment:
#   .env.development  -> npm run dev
#   .env.staging      -> npm run dev:stage / build:stage / start:stage
#   .env.production   -> npm run build / start
#
# Put secrets and machine-specific overrides in a matching *.local file
# (e.g. .env.staging.local). Those are git-ignored and take precedence.
#
# NEXT_PUBLIC_* values are inlined into the browser bundle at BUILD time,
# so never put secrets in them, and rebuild after changing them.

# Which environment the app thinks it is: development | staging | production
NEXT_PUBLIC_APP_ENV=development

# Display name (the environment name is appended outside production)
NEXT_PUBLIC_APP_NAME=AuditApp

# Public base URL of this deployment, no trailing slash
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Base URL of the audit-service API, including /api (all data is fetched from here)
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api
