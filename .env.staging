# Non-secret defaults for staging (npm run dev:stage / build:stage / start:stage).
# Replace the placeholder URLs with your staging hosts.
# Secrets go in .env.staging.local or the hosting provider's settings.
NEXT_PUBLIC_APP_ENV=staging
NEXT_PUBLIC_APP_NAME=AuditApp
NEXT_PUBLIC_SITE_URL=https://staging.auditapp.example.com
NEXT_PUBLIC_API_BASE_URL=https://staging-api.auditapp.example.com/api
